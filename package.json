{
  "name": "dsh-long-input",
  "version": "0.2.0",
  "description": "Long-form Markdown input dialog for the DeepSeek Harness Web composer",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/DingL0312/dsh-long-input-window.git" },
"homepage": "https://github.com/DingL0312/dsh-long-input-window#readme",
"bugs": { "url": "https://github.com/DingL0312/dsh-long-input-window/issues" },
"keywords": ["dsh-plugin", "dsh","long-input", "markdown"],

  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/marked.min.js",
    "locale/*.json",
    "icon.svg",
    "screenshots.json",
    "README.md",
    "README.en.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
